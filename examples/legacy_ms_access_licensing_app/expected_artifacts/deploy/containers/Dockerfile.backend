# syntax=docker/dockerfile:1
FROM python:3.11.9-slim-bookworm AS builder
WORKDIR /build
COPY src/ /build/src/

FROM python:3.11.9-slim-bookworm AS runtime
LABEL org.opencontainers.image.title="business-licensing-portal-backend" \
      io.agentic.dlc.abstraction-plane="gdc-fleet" \
      io.agentic.dlc.spec-sha256="f24b55aef673007206243087e327f4794cabc93d61dd9f2145ffac1ada99c73b" \
      io.agentic.dlc.capability-groups="GRP-01,GRP-02,GRP-03"
RUN groupadd -g 65532 nonroot && useradd -u 65532 -g 65532 -s /sbin/nologin -M nonroot
WORKDIR /app
COPY --from=builder --chown=65532:65532 /build/src /app/src
ENV PORT=8767 \
    PYTHONUNBUFFERED=1 \
    OTEL_SERVICE_NAME="business-licensing-portal-backend" \
    OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector.observability.svc.cluster.local:4317"
EXPOSE 8767
USER 65532:65532
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8767/health').read()"]
CMD ["python3", "src/backend/server.py"]
