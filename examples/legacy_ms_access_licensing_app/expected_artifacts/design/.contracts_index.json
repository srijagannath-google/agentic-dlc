  "guardrailBindings": {
    "stateTransitions": [
      {
        "from": "DRAFT",
        "to": "SUBMITTED",
        "trigger": "Submit",
        "roles": [
          "Commercial Buyer"
        ],
        "guard": "required fields present; bond amount ≥ required bond (BR-01); every agent satisfies exclusivity (BR-02); no other non-rejected application for the same buyer and licence year (BR-04); evidence: discovery §3 row 1"
      },
      {
        "from": "SUBMITTED",
        "to": "ISSUED",
        "trigger": "Issue",
        "roles": [
          "Licensing Staff"
        ],
        "guard": "buyer not suspended; bond amount ≥ required bond (BR-01); every active agent satisfies exclusivity (BR-02) and is not suspended (BR-06); evidence: discovery §3 row 2"
      },
      {
        "from": "SUBMITTED",
        "to": "REJECTED",
        "trigger": "Reject",
        "roles": [
          "Licensing Staff"
        ],
        "guard": "decision reason of at least 10 characters recorded; evidence: discovery §3 row 3 and ASSUMPTION-01"
      }
    ],
    "businessRuleIds": [
      "BR-01",
      "BR-02",
      "BR-03",
      "BR-04",
      "BR-05",
