        S4["<b>Staff Compliance Console</b><br/>Issuance &amp; Rejection Decisions"]:::dataCard
    end

    subgraph SG_Stage2["2. Ingestion, Validation & CDC"]
        I1["<b>OpenAPI Schema Gate</b><br/>Type, State &amp; Bond Checks"]:::dataCard
