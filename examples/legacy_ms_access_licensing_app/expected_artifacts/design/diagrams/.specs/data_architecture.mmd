        I4["<b>MIME &amp; Size Validator</b><br/>10 MB Attachment Guard"]:::dataCard
    end

    subgraph SG_Stage3["3. Operational 3NF System of Record"]
        D1["<b>3NF Licensing Primary DB</b><br/>ACID Buyers, Apps &amp; Agents"]:::dataCard
