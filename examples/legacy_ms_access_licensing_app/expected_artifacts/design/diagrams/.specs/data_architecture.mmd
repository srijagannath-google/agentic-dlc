        G3["<b>KMS Encryption (CMEK)</b><br/>TLS 1.3 &amp; AES-256 at Rest"]:::govCard
        G4["<b>Statutory Retention</b><br/>7-Year Regulatory Archive"]:::govCard
    end

    SG_Stage1 ==> SG_Stage2 ==> SG_Stage3 ==> SG_Stage4 ==> SG_Stage5
