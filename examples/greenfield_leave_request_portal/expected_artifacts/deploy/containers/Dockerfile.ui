# syntax=docker/dockerfile:1
FROM python:3.11.9-slim-bookworm AS runtime
LABEL org.opencontainers.image.title="leave-request-portal-ui" \
      io.agentic.dlc.abstraction-plane="gdc-fleet" \
      io.agentic.dlc.spec-sha256="122f76cd2e98b6d8f4a42e43441e084607e19c645bd4447424736bba1ff814ef" \
      io.agentic.dlc.capability-groups="GRP-01,GRP-02,GRP-03"
RUN groupadd -g 65532 nonroot && useradd -u 65532 -g 65532 -s /sbin/nologin -M nonroot
WORKDIR /app
COPY --chown=65532:65532 src/ui /app/src/ui
EXPOSE 8766
USER 65532:65532
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8766/').read()"]
CMD ["python3", "-m", "http.server", "8766", "--directory", "/app/src/ui"]
