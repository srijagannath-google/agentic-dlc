# syntax=docker/dockerfile:1
FROM python:3.11.9-slim-bookworm AS builder
WORKDIR /build
COPY src/ /build/src/

FROM python:3.11.9-slim-bookworm AS runtime
LABEL org.opencontainers.image.title="leave-request-portal-backend" \
      io.agentic.dlc.abstraction-plane="gdc-fleet" \
      io.agentic.dlc.spec-sha256="da46761b820842390b60641fc8661b470f0a683d283e5328b79be11ddb66e648" \
      io.agentic.dlc.capability-groups="GRP-01,GRP-02,GRP-03"
RUN groupadd -g 65532 nonroot && useradd -u 65532 -g 65532 -s /sbin/nologin -M nonroot
WORKDIR /app
COPY --from=builder --chown=65532:65532 /build/src /app/src
ENV PORT=8766 \
    PYTHONUNBUFFERED=1 \
    OTEL_SERVICE_NAME="leave-request-portal-backend" \
    OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector.observability.svc.cluster.local:4317"
EXPOSE 8766
USER 65532:65532
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8766/health').read()"]
CMD ["python3", "src/backend/server.py"]
