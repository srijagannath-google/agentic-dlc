{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-dlc.local/schemas/gate_approvals.schema.json",
  "title": "specs/gate_approvals.json (Machine-enforced Human Gate Ledger across Stages 0..9)",
  "type": "object",
  "required": ["schemaVersion", "gates"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "4.0" },
    "initializedAtUtc": { "type": ["string", "null"] },
    "ceremonyTrack": { "type": "string", "enum": ["quick", "standard", "regulated"] },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["gateId", "stage", "status"],
        "additionalProperties": false,
        "properties": {
          "gateId": { "type": "string" },
          "stage": { "type": "string" },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "NOT_STARTED",
              "AWAITING_HUMAN_REVIEW",
              "APPROVED_BY_USER",
              "PRE_APPROVED_AUTONOMOUS",
              "AUTONOMOUS_DEFAULT",
              "AUTO_SKIPPED_BY_CEREMONY_TRACK"
            ]
          },
          "readyAtUtc": { "type": ["string", "null"] },
          "readyAtEpoch": { "type": ["number", "null"] },
          "approvedAtUtc": { "type": ["string", "null"] },
          "userResponse": { "type": ["string", "null"] },
          "summary": { "type": ["string", "null"] },
          "decisionBriefPath": { "type": ["string", "null"] },
          "approvers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Sanitized human approver usernames/identities (bot and agent accounts strictly excluded; >= 2 distinct humans required on 'regulated' Two-Person Review gates when specified)."
          },
          "originalAuthor": { "type": ["string", "null"] },
          "pairCollaborators": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Human collaborators or reviewers who provided substantive architectural or implementation steering (never mutually exclusive with approvers)."
          },
          "manuallyVerifiedBy": { "type": ["string", "null"] },
          "artifactSha256": { "type": ["string", "null"] }
        }
      }
    }
  }
}
