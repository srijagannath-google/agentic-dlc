{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-dlc.local/schemas/drift_report.schema.json",
  "title": "test/drift_report.json (Stage 7 Pre-Deployment & Day-2 Spec-to-Code Drift & Contract Alignment Report)",
  "type": "object",
  "required": [
    "schemaVersion", "checkedAtUtc", "verdict", "summary", "findings"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "4.0" },
    "checkedAtUtc": { "type": "string" },
    "verdict": { "type": "string", "enum": ["ALIGNED", "DRIFT_DETECTED"] },
    "specSha256": { "type": ["string", "null"] },
    "openapiSha256": { "type": ["string", "null"] },
    "schemaSqlSha256": { "type": ["string", "null"] },
    "summary": {
      "type": "object",
      "required": ["totalFindings", "errors", "warnings", "adrsRecorded", "contractPragmasFound"],
      "properties": {
        "totalFindings": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "adrsRecorded": { "type": "integer", "minimum": 0 },
        "contractPragmasFound": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "artifact", "codeLocation", "description", "remediation"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning"] },
          "category": { "type": "string", "enum": ["artifact-hash", "openapi-route", "ddl-schema", "state-machine", "testid-contract", "adr-coverage"] },
          "artifact": { "type": "string" },
          "codeLocation": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "adrs": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
