{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-dlc.local/schemas/architecture_scorecard.schema.json",
  "title": "design/architecture_eval_scorecard.json (Stage 4A — scored by architecture-critic; validated by 04/scripts/validate_architecture_scorecard.py)",
  "type": "object",
  "required": [
    "schemaVersion", "rubricVersion", "architectureSha256", "solutionDesignSha256",
    "inputScenario", "dimensionTotals", "totalScore", "verdict", "criteria", "blockingGaps"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "4.0" },
    "rubricVersion": { "type": "string", "const": "4.0" },
    "judgedAtUtc": { "type": "string" },
    "evaluatedAtUtc": { "type": "string" },
    "architectureSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "solutionDesignSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "inputScenario": { "type": "string", "enum": ["SCENARIO_LEGACY_APP", "SCENARIO_REQUIREMENTS_DOC"] },
    "totalScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "passingScore": { "type": "integer", "const": 90 },
    "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
    "dimensionTotals": {
      "type": "object",
      "required": ["DomainLogic", "SecurityZeroTrust", "ResilienceScale", "OperabilityFinOps"],
      "properties": {
        "DomainLogic": { "type": "integer", "minimum": 0, "maximum": 30 },
        "SecurityZeroTrust": { "type": "integer", "minimum": 0, "maximum": 30 },
        "ResilienceScale": { "type": "integer", "minimum": 0, "maximum": 20 },
        "OperabilityFinOps": { "type": "integer", "minimum": 0, "maximum": 20 }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "dimension", "awarded", "maxPoints", "evidence", "gap"],
        "properties": {
          "id": { "type": "string", "pattern": "^ARCH-[A-Z]+-[0-9]+$" },
          "dimension": { "type": "string", "enum": ["DomainLogic", "SecurityZeroTrust", "ResilienceScale", "OperabilityFinOps"] },
          "title": { "type": "string" },
          "awarded": { "type": "integer", "minimum": 0 },
          "maxPoints": { "type": "integer", "minimum": 1 },
          "blocking": { "type": "boolean" },
          "critique": { "type": "string" },
          "evidence": { "type": "string" },
          "gap": { "type": "string" }
        }
      }
    },
    "blockingGaps": { "type": "array", "items": { "type": "string" } },
    "redTeamFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "persona", "finding", "remediation"],
        "properties": {
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "persona": { "type": "string", "enum": ["DomainLogicSkeptic", "ZeroTrustSecurityAdversary", "SREFinOpsCritic"] },
          "finding": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
