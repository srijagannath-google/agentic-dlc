{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-dlc.local/schemas/user_stories.schema.json",
  "title": "backlog/user_stories.json (Stage 3 — written by the LLM sprint-planner-agent)",
  "type": "object",
  "required": ["schemaVersion", "stories"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "4.0" },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/story" }
    }
  },
  "$defs": {
    "acceptanceCriterion": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "tag", "given", "when", "then"],
          "properties": {
            "id": { "type": "string", "pattern": "^AC-[0-9]{2,}$" },
            "tag": {
              "type": "string",
              "enum": [
                "POSITIVE", "NEGATIVE", "NEGATIVE — ROLE VISIBILITY", "NEGATIVE — WORKFLOW PREREQUISITE GATE",
                "POSITIVE — INTERACTIVE COMPLETENESS", "EDGE / BOUNDARY"
              ]
            },
            "given": { "type": "string", "minLength": 1 },
            "when": { "type": "string", "minLength": 1 },
            "then": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "string",
          "description": "Legacy v3 form '[TAG] GIVEN … WHEN … THEN …' — accepted by scripts, not to be produced by new output.",
          "pattern": "^\\s*\\[[^\\]]+\\].*GIVEN.*WHEN.*THEN"
        }
      ]
    },
    "story": {
      "type": "object",
      "required": ["id", "type", "title", "narrative", "requirementRefs", "roles", "sprint", "priority", "storyPoints", "acceptanceCriteria"],
      "properties": {
        "id": { "type": "string", "pattern": "^US-(FUNC|TECH)-[0-9]{2,}$" },
        "type": { "type": "string", "enum": ["Functional", "Technical"] },
        "title": { "type": "string", "minLength": 1 },
        "narrative": { "type": "string", "minLength": 1 },
        "requirementRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^REQ-[A-Z0-9]+-[0-9]+$" } },
        "businessRuleRefs": { "type": "array", "items": { "type": "string", "pattern": "^BR-[0-9]+$" } },
        "legacyArtifactsReplaced": { "type": "array", "items": { "type": "string" } },
        "capabilityGroup": {
          "type": "string",
          "pattern": "^(GRP-[0-9]{2,}|SHARED)$",
          "description": "Capability Group ID from Stage 1 §6.1 (GRP-01..N) or 'SHARED' for cross-cutting US-TECH-* foundation stories."
        },
        "capabilityGroupName": {
          "type": "string",
          "description": "Human-readable name of the Capability Group (business functionality or business unit / department)."
        },
        "roles": { "type": "array", "items": { "type": "string" } },
        "workflowTransitions": {
          "type": "array",
          "items": { "type": "string", "description": "'<From>-><To>' using state names exactly as in spec §3.3" }
        },
        "sprint": { "type": "string", "pattern": "^(Sprint [0-9]+|Product Backlog)$" },
        "priority": { "type": "string", "enum": ["Highest", "High", "Medium", "Low"] },
        "storyPoints": { "type": "integer", "minimum": 1, "maximum": 8 },
        "status": { "type": "string", "enum": ["To Do", "In Progress", "Done"] },
        "statusReason": { "type": "string" },
        "statusUpdatedAtUtc": { "type": "string" },
        "jiraKey": { "type": ["string", "null"] },
        "adoWorkItemId": { "type": ["integer", "null"] },
        "traceability": {
          "type": "object",
          "description": "End-to-end bidirectional traceability matrix linking Legacy/Input Sources -> Requirements & Business Rules -> Design Contracts -> Target Source Code -> Test Cases -> Defects.",
          "properties": {
            "legacySourceArtifacts": { "type": "array", "items": { "type": "string" } },
            "requirementRefs": { "type": "array", "items": { "type": "string" } },
            "businessRuleRefs": { "type": "array", "items": { "type": "string" } },
            "workflowTransitions": { "type": "array", "items": { "type": "string" } },
            "apiContracts": { "type": "array", "items": { "type": "string" } },
            "databaseTables": { "type": "array", "items": { "type": "string" } },
            "targetSourceFiles": { "type": "array", "items": { "type": "string" } },
            "uiTestIds": { "type": "array", "items": { "type": "string" } },
            "testCases": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": { "type": "string" },
                  "category": { "type": "string" },
                  "status": { "type": "string" }
                }
              }
            },
            "defectRefs": { "type": "array", "items": { "type": "string" } },
            "gdcDeployment": {
              "type": "object",
              "properties": {
                "abstractionPlane": { "type": "string" },
                "targetEnvironments": { "type": "array", "items": { "type": "string" } },
                "rolloutWave": { "type": "integer" },
                "verdict": { "type": "string" }
              }
            }
          }
        },
        "acceptanceCriteria": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/acceptanceCriterion" } }
      }
    }
  }
}
