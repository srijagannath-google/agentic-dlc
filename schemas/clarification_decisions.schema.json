{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic DLC Conditional Clarification & Modernization Decision Ledger (specs/clarification_decisions.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updatedAtUtc",
    "clarificationStatus",
    "roundsCompleted",
    "triggerReasons",
    "capabilityDispositions",
    "decisions",
    "openFrontier"
  ],
  "properties": {
    "schemaVersion": {
      "const": "4.0"
    },
    "updatedAtUtc": {
      "type": "string",
      "minLength": 10
    },
    "clarificationStatus": {
      "type": "string",
      "enum": [
        "CLEAR_AUTO_BYPASSED",
        "IN_PROGRESS",
        "RESOLVED_BY_HUMAN",
        "ACCEPTED_RECOMMENDATIONS",
        "AUTONOMOUS_ASSUMPTIONS"
      ]
    },
    "roundsCompleted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "triggerReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "capabilityDispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetId",
          "disposition",
          "rationale"
        ],
        "properties": {
          "targetId": {
            "type": "string",
            "minLength": 2,
            "description": "Discovered Capability ID (CAP-NN) or Business Capability Group ID (GRP-NN)"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "retire",
              "parity",
              "reimagine-enhance"
            ]
          },
          "enhancementSummary": {
            "type": [
              "string",
              "null"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "round",
          "category",
          "evidenceSource",
          "question",
          "recommendedAnswer",
          "resolvedAnswer",
          "resolvedBy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DECISION-[0-9]{2,4}$"
          },
          "round": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "parentDecisionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "modernization-ambition",
              "capability-disposition",
              "workflow-state",
              "business-rule",
              "acronym-definition",
              "security-pii",
              "ux-ai-surface",
              "architecture-stack"
            ]
          },
          "evidenceSource": {
            "type": "string",
            "minLength": 3
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "recommendedAnswer": {
            "type": "string",
            "minLength": 3
          },
          "resolvedAnswer": {
            "type": "string",
            "minLength": 1
          },
          "resolvedBy": {
            "type": "string",
            "enum": [
              "user",
              "accepted-recommendation",
              "autonomous-default"
            ]
          }
        }
      }
    },
    "openFrontier": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "questionId",
          "round",
          "category",
          "evidenceSource",
          "question",
          "recommendedAnswer"
        ],
        "properties": {
          "questionId": {
            "type": "string",
            "pattern": "^Q[0-9]+$"
          },
          "round": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "parentDecisionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "modernization-ambition",
              "capability-disposition",
              "workflow-state",
              "business-rule",
              "acronym-definition",
              "security-pii",
              "ux-ai-surface",
              "architecture-stack"
            ]
          },
          "evidenceSource": {
            "type": "string",
            "minLength": 3
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "recommendedAnswer": {
            "type": "string",
            "minLength": 3
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
