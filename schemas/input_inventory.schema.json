{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-dlc.local/schemas/input_inventory.schema.json",
  "title": "specs/input_inventory.json (Stage 1 — written by 01/scripts/scan_input_sources.py)",
  "type": "object",
  "required": [
    "schemaVersion", "scannedAtUtc", "projectRoot", "domainSlug", "inputScenario", "scenarioEvidence",
    "scenarioConfidence", "includeModernizationEnhancementsInSpec", "hasPoliciesOrStatutes",
    "hasUserProvidedDesignReferences", "userProvidedDesignReferences", "inputFingerprintSha256", "files"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "4.0" },
    "scannedAtUtc": { "type": "string" },
    "projectRoot": { "type": "string" },
    "domainSlug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "domainSlugSource": { "type": "string", "enum": ["flag", "primary-document-h1", "primary-document-filename", "project-directory-name", "source-repository"] },
    "sourceRepository": {
      "type": ["object", "null"],
      "description": "Optional provenance metadata when Stage 1 ingests inputs from an Azure DevOps (ADO) or Git repository.",
      "properties": {
        "provider": { "type": "string", "enum": ["ado", "git", "local"] },
        "repositoryUrl": { "type": "string" },
        "repositoryName": { "type": "string" },
        "branch": { "type": ["string", "null"] },
        "commitSha": { "type": ["string", "null"] },
        "localCheckoutPath": { "type": "string" }
      }
    },
    "inputScenario": { "type": "string", "enum": ["SCENARIO_LEGACY_APP", "SCENARIO_REQUIREMENTS_DOC"] },
    "scenarioEvidence": {
      "type": "object",
      "required": ["legacyArtifactCount", "requirementsDocCount", "decisionRule"],
      "properties": {
        "legacyArtifactCount": { "type": "integer", "minimum": 0 },
        "requirementsDocCount": { "type": "integer", "minimum": 0 },
        "legacyWeight": { "type": "integer", "minimum": 0 },
        "requirementsWeight": { "type": "integer", "minimum": 0 },
        "decisionRule": { "type": "string" }
      }
    },
    "scenarioConfidence": { "type": "string", "enum": ["HIGH", "LOW"] },
    "includeModernizationEnhancementsInSpec": { "type": "boolean" },
    "hasPoliciesOrStatutes": { "type": "boolean" },
    "hasUserProvidedDesignReferences": { "type": "boolean" },
    "userProvidedDesignReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relativePath", "designType"],
        "properties": {
          "relativePath": { "type": "string" },
          "designType": { "type": "string", "enum": ["figma", "stitch", "sample_ui", "style_guide", "tokens"] }
        }
      }
    },
    "legacyObjectNames": {
      "type": "array",
      "description": "Real table/element/form/report object names found inside legacy artefacts (CREATE TABLE, XSD element, `Name=` object line, prefixed Access identifier). Feeds forbiddenUiTokens.legacyIdentifiers (FAIL-level).",
      "items": { "type": "string" }
    },
    "legacyFileStems": {
      "type": "array",
      "description": "Bare file-name stems of legacy artefacts (not object names). Downstream scripts treat collisions with these as WARN only (forbiddenUiTokens.legacyIdentifiersWarnOnly).",
      "items": { "type": "string" }
    },
    "dependencyDagSummary": {
      "type": "object",
      "description": "Deterministic static dependency & call/FK graph summary written alongside specs/dependency_dag.json to ground §6.1 Business Capability Groupings and wave sequencing.",
      "required": ["dagFile", "nodeCount", "edgeCount", "tierCount", "hasCycles", "tiers"],
      "properties": {
        "dagFile": { "type": ["string", "null"] },
        "nodeCount": { "type": "integer", "minimum": 0 },
        "edgeCount": { "type": "integer", "minimum": 0 },
        "tierCount": { "type": "integer", "minimum": 0 },
        "hasCycles": { "type": "boolean" },
        "tiers": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "topLevelModuleCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of distinct top-level source directories/modules in resources/inputs."
    },
    "largeRepoMapReduceRecommended": {
      "type": "boolean",
      "description": "True when topLevelModuleCount > 15 or totalFilesScanned > 60, recommending hierarchical Peanuts-and-Hay map-reduce discovery."
    },
    "unverifiedAcronyms": {
      "type": "array",
      "description": "All-caps domain acronyms detected in inputs that lack an explicit inline expansion; Gate 1 must ask rather than guess expansions.",
      "items": { "type": "string" }
    },
    "detectedAmbiguities": {
      "type": "array",
      "description": "Cross-artifact numeric/rule contradictions or explicit TBD/CONFLICT ambiguity markers detected across input files that trigger a Grill-Me clarification round.",
      "items": {
        "type": "object",
        "required": ["kind", "identifier", "summary", "files"],
        "properties": {
          "kind": { "type": "string", "enum": ["conflicting-numeric-rule", "explicit-ambiguity-marker"] },
          "identifier": { "type": "string" },
          "summary": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "runtimeReadinessSignals": {
      "type": "object",
      "description": "Deterministic brownfield runtime, OS-portability, ORM/database, cloud-SDK, and horizontal-scaling readiness signals extracted from project manifests (.sln, .csproj, web.config, pom.xml) and source code.",
      "required": [
        "detectedFrameworks", "osAndPlatformBlockers", "databaseAndOrmCoupling",
        "cloudSdkCoupling", "statelessScalingHazards", "recommendedModernizationMode"
      ],
      "properties": {
        "detectedFrameworks": { "type": "array", "items": { "type": "string" } },
        "nugetOrMavenPackages": { "type": "array", "items": { "type": "string" } },
        "osAndPlatformBlockers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["signal", "category", "file"],
            "properties": {
              "signal": { "type": "string" },
              "category": { "type": "string" },
              "file": { "type": "string" }
            }
          }
        },
        "databaseAndOrmCoupling": { "type": "array", "items": { "type": "string" } },
        "cloudSdkCoupling": { "type": "array", "items": { "type": "string" } },
        "statelessScalingHazards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["signal", "file"],
            "properties": {
              "signal": { "type": "string" },
              "file": { "type": "string" }
            }
          }
        },
        "recommendedModernizationMode": {
          "type": "string",
          "enum": ["clean-room-rebuild", "in-place-upgrade"]
        },
        "recommendationReason": { "type": "string" }
      }
    },
    "inputFingerprintSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relativePath", "name", "extension", "sizeBytes", "sha256", "category"],
        "properties": {
          "relativePath": { "type": "string" },
          "name": { "type": "string" },
          "extension": { "type": "string" },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "category": {
            "type": "string",
            "enum": [
              "legacy_schema", "legacy_query", "legacy_form", "legacy_report", "legacy_source",
              "requirements_doc", "policy", "design_reference", "shared_service", "other"
            ]
          },
          "scenarioWeight": { "type": "integer", "minimum": 0 },
          "categoryReason": { "type": "string" }
        }
      }
    }
  }
}
